            "url": {
              "raw": "{{base_url}}{{api_prefix}}/users/:id",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "users", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "user-uuid-here"
                }
              ]
            },
            "description": "Mettre à jour les informations d'un utilisateur"
