        {
          "name": "Mettre à jour Utilisateur",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"John Updated\",\n  \"lastname\": \"Doe Updated\",\n  \"bio\": \"Bio mise à jour\",\n  \"phone\": \"+33123456789\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/users/:id",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "users", ":id"],
