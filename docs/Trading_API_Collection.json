          "response": []
        },
        {
          "name": "Supprimer Utilisateur",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/users/:id",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "users", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "user-uuid-here"
                }
              ]
            },
            "description": "Supprimer un utilisateur"
          },
          "response": []
        }
