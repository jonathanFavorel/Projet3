{
  "info": {
    "name": "Trading API Backend",
    "description": "API complète pour l'application de trading avec gestion des utilisateurs, analyses, trades et comptes",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "api_prefix",
      "value": "/api/v1",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "🔍 Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Vérifier le statut de santé de l'API"
          },
          "response": []
        },
        {
          "name": "API Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Obtenir les informations générales de l'API"
          },
          "response": []
        }
      ]
    },
    {
      "name": "🔐 Authentification",
      "item": [
        {
          "name": "Inscription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nameTag\": \"trader123\",\n  \"firstname\": \"John\",\n  \"lastname\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"+33123456789\",\n  \"password\": \"MotDePasse123!\",\n  \"bio\": \"Trader passionné depuis 5 ans\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "auth", "register"]
            },
            "description": "Créer un nouveau compte utilisateur"
          },
          "response": []
        },
        {
          "name": "Connexion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"MotDePasse123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "auth", "login"]
            },
            "description": "Se connecter avec email et mot de passe"
          },
          "response": []
        },
        {
          "name": "Profil Utilisateur",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "auth", "me"]
            },
            "description": "Récupérer les informations de l'utilisateur connecté"
          },
          "response": []
        },
        {
          "name": "Déconnexion",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "auth", "logout"]
            },
            "description": "Se déconnecter"
          },
          "response": []
        }
      ]
    },
    {
      "name": "👥 Utilisateurs",
      "item": [
        {
          "name": "Liste des Utilisateurs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/users?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "users"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Récupérer la liste des utilisateurs avec pagination"
